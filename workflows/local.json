    {
      "parameters": {
        "jsCode": "const cfg = $('CONFIG1').first().json;\nconst token = $('Get Feishu Tenant Token1').first().json.tenant_access_token;\n\nconst api = $json;\n\nif (api.code !== undefined && api.code !== 0) {\n  throw new Error(\n    `飞书读取记录失败 code=${api.code}, msg=${api.msg || ''}`\n  );\n}\n\nconst record = api.data?.record ?? api.data ?? api.record ?? api;\nconst fields = record.fields ?? {};\nconst recordId = record.record_id ?? cfg.record_id;\n\nconst asAttachments = (value) => {\n  return Array.isArray(value)\n    ? value.filter(Boolean)\n    : [];\n};\n\nconst asText = (value) => {\n  if (value === null || value === undefined) {\n    return \"\";\n  }\n\n  if (\n    typeof value === \"string\" ||\n    typeof value === \"number\"\n  ) {\n    return String(value);\n  }\n\n  if (Array.isArray(value)) {\n    return value\n      .map((item) => {\n        if (\n          typeof item === \"string\" ||\n          typeof item === \"number\"\n        ) {\n          return String(item);\n        }\n\n        return (\n          item?.text ??\n          item?.name ??\n          item?.value ??\n          \"\"\n        );\n      })\n      .filter(Boolean)\n      .join(\", \");\n  }\n\n  return (\n    value?.text ??\n    value?.name ??\n    value?.value ??\n    \"\"\n  );\n};\n\nconst sequence = asText(fields[\"序号\"]);\n\nconst templateVideos = asAttachments(\n  fields[\"模板视频\"]\n);\n\nconst referenceImages = asAttachments(\n  fields[\"人物参考图\"]\n).slice(0, 3);\n\nconst genderRaw = asText(\n  fields[\"人物性别\"]\n);\n\nconst currentStatus = asText(\n  fields[\"状态\"]\n);\n\nif (currentStatus === '生成中') return [{json: {skip_duplicate: true, record_id: recordId}}];\nlet validationError = \"\";\n\nif (!templateVideos.length) {\n  validationError = \"缺少模板视频\";\n} else if (!referenceImages.length) {\n  validationError = \"缺少人物参考图\";\n} else if (!genderRaw) {\n  validationError = \"缺少人物性别\";\n}\n\nconst templateVideo = templateVideos[0];\n\nconst normalizedGender = genderRaw\n  .trim()\n  .toLowerCase();\n\nconst isFemale =\n  normalizedGender.includes(\"female\") ||\n  normalizedGender.includes(\"woman\") ||\n  genderRaw.includes(\"女\");\n\nconst gender = isFemale\n  ? \"Female\"\n  : \"Male\";\n\n\nconst refTags = referenceImages\n  .map((_, index) => `<IMAGE_REF_${index}>`)\n  .join(\", \");\n\nconst primaryRefTag = referenceImages.length\n  ? \"<IMAGE_REF_0>\"\n  : \"the primary visual reference\";\n\nconst secondaryRefTags = referenceImages\n  .slice(1)\n  .map(\n    (_, index) =>\n      `<IMAGE_REF_${index + 1}>`\n  )\n  .join(\", \");\n\nconst refNames = referenceImages\n  .map((item, index) => {\n    const name =\n      item?.name ||\n      item?.file_token ||\n      `reference_${index}`;\n\n    return `${index}: ${name}`;\n  })\n  .join(\"; \");\n\nconst secondaryReferenceInstruction =\n  secondaryRefTags\n    ? `Use ${secondaryRefTags} only as additional references for profile angles and body proportions.`\n    : \"\";\n\nconst promptTemplate = `\nVIDEO CHARACTER APPEARANCE EDIT\n\nProduction:\n- Source: ${templateVideo?.name || \"N/A\"}\n- Character gender: ${gender}\n- Visual references: ${refNames || \"N/A\"}\n- Segment: {{SEGMENT_INDEX}} of {{SEGMENT_COUNT}}\n- Duration: {{SEGMENT_DURATION}} seconds\n\nTASK:\nUse the supplied video segment as the base footage.\nUpdate the visual appearance of the primary adult performer so that the same consistent character shown in ${refTags} appears throughout the segment.\nUse the reference images only as visual guides. Do not use them as literal video frames.\n\nREFERENCE PRIORITY:\nUse ${primaryRefTag} as the main reference for facial appearance, hairstyle, hair length, hair color, hairline, clothing, clothing colors, glasses, makeup, facial hair, and accessories.\n${secondaryReferenceInstruction}\nIf the references differ, always follow ${primaryRefTag}.\nDo not combine different outfits, hairstyles, or accessories.\n\nCHARACTER CONSISTENCY:\nKeep the character visually consistent in every frame:\n- same facial appearance and facial proportions\n- same age appearance and skin tone\n- same hairstyle, hair length, hair color, and hairline\n- same clothing, clothing colors, collar, sleeves, and visible layers\n- same glasses, makeup, facial hair, and accessories\n- same body proportions\n\nThe hairstyle and clothing shown in ${primaryRefTag} must remain unchanged.\nKeep the same character during head turns, profile views, body movement, partial occlusion, lighting changes, camera movement, and scene changes.\nAvoid appearance drift or sudden visual changes between frames.\n\nSOURCE PRESERVATION:\nPreserve the source video's:\n- pose and movement\n- hand gestures\n- performance timing\n- camera movement\n- composition and framing\n- scene and background\n- lighting and objects\n- cuts and transitions\n- on-screen text\n\nPreserve the exact crop, aspect ratio, field of view, camera distance, lens perspective, subject position, head size, and body scale.\nDo not add zooms, crop changes, reframing, stretching, or subject enlargement unless already present in the source.\nDo not turn a medium shot into a close-up.\nDo not add people, objects, text, logos, or backgrounds.\nKeep unrelated visual elements unchanged.\n\nVISUAL STABILITY:\nMaintain natural and stable eyes, mouth, teeth, jaw, ears, glasses, neck, shoulders, hands, and fingers.\nAvoid warped features, duplicated features, unstable glasses, oversized heads, distorted mouths, malformed hands, and changing body proportions.\nPrioritize character consistency, stable anatomy, original framing, and original movement.\n\nAUDIO:\nEdit the visual track only. Do not synthesize, replace, translate, or alter speech.\nThe original source audio will be preserved separately, with its original timing.\n\nCONTINUITY:\nThis segment is part of a longer video.\nAcross all segments, maintain the same facial appearance, hairstyle, clothing, colors, glasses, accessories, body proportions.\nKeep segment boundaries visually and audibly compatible.\nAvoid wardrobe changes, hairstyle changes, appearance drift, sudden zooms, crop changes, scale changes.\n\nReturn the edited video segment while preserving the structure and timing of the source footage.\n`.trim();\n\nif (promptTemplate.length > 5000) {\n  throw new Error(\n    `提示词长度为 ${promptTemplate.length} 个字符，超过 Worker 的 5000 字符限制`\n  );\n}\n\nreturn [\n  {\n    json: {\n      record_id: recordId,\n      sequence,\n      current_status: currentStatus,\n      validation_error: validationError,\n\n      table_id: cfg.table_id,\n\n      app_token:\n        $('Get Wiki Bitable Token1')\n          .first()\n          .json\n          .data\n          .node\n          .obj_token,\n\n      template_video: templateVideo,\n      reference_images: referenceImages,\n\n      target_gender: gender,\n\n      prompt_template: promptTemplate,\n\n      worker_base_url:\n        cfg.worker_base_url.replace(\n          /\\/+$/,\n          \"\"\n        ),\n\n      google_drive_folder_id:\n        cfg.google_drive_folder_id,\n\n      feishu_access_token:\n        token\n    }\n  }\n];"
      },
