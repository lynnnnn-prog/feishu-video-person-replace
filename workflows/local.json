      "parameters": {
        "jsCode": "const body = $json.body ?? $json;\nconst CONFIG = {\n  \"wiki_node_token\": \"YOUR_WIKI_NODE_TOKEN\",\n  \"table_id\": \"YOUR_TABLE_ID\",\n  \"worker_base_url\": \"https://YOUR_WORKER_HOST\",\n  \"google_drive_folder_id\": \"YOUR_DRIVE_FOLDER_ID\",\n  \"poll_timeout_seconds\": 6000\n};\nconst recordId = body.record_id ?? body.recordId ?? body.data?.record_id ?? body.data?.recordId;\nif (typeof recordId !== 'string' || !/^rec[A-Za-z0-9]+$/.test(recordId)) throw new Error('Missing or invalid record_id');\nfor (const [key, value] of Object.entries(CONFIG)) {\n  if (typeof value === 'string' && value.includes('YOUR_')) throw new Error('Configure ' + key + ' first');\n}\nif (!/^https:\\/\\/[^/]+/.test(CONFIG.worker_base_url)) throw new Error('Worker requires an HTTPS URL');\nreturn [{json: {...CONFIG, record_id: recordId}}];"
      },
